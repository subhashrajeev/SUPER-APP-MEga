# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ivr_interiors?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ivr_interiors?schema=public"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IVR INTERIORS"
NODE_ENV="development"

# Authentication & Security
NEXTAUTH_SECRET="your-nextauth-secret-min-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-min-32-characters-long"
SESSION_SECRET="your-session-secret-min-32-characters-long"

# Supabase (Authentication & Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Payment Gateways
# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Razorpay (Alternative payment gateway for India)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# Maps & Routing
# Mapbox (primary)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN="pk.eyJ1..."
MAPBOX_SECRET_TOKEN="sk.eyJ1..."

# Google Maps (alternative)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."
GOOGLE_MAPS_SERVER_KEY="AIza..."

# AI & ML Services
# OpenAI
OPENAI_API_KEY="sk-proj-..."
OPENAI_ORG_ID="org-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Stable Diffusion / Replicate
REPLICATE_API_TOKEN="r8_..."
STABILITY_API_KEY="sk-..."

# Image Processing
# Remove.bg (background removal)
REMOVE_BG_API_KEY="your-remove-bg-key"

# Upscaler / Enhancement
DEEPAI_API_KEY="your-deepai-key"

# Communication
# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@ivrinteriors.com"
SMTP_FROM_NAME="IVR INTERIORS"

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="whatsapp:+1234567890"

# WhatsApp Business API (Alternative)
WHATSAPP_BUSINESS_PHONE_ID="your-phone-id"
WHATSAPP_BUSINESS_ACCESS_TOKEN="your-access-token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-verify-token"

# Google Calendar Integration
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# Analytics & Monitoring
# PostHog
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="ivrinteriors.com"

# Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-org"
SENTRY_PROJECT="your-project"

# File Storage
# AWS S3 (optional)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="ivr-interiors-uploads"

# Cloudinary (alternative)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# PDF Generation
# Puppeteer settings
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium-browser"
PUPPETEER_SKIP_DOWNLOAD="false"

# Rate Limiting & Security
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# Feature Flags
ENABLE_AI_FEATURES="true"
ENABLE_3D_VIEWER="true"
ENABLE_AR_MEASUREMENT="true"
ENABLE_VIDEO_GENERATION="true"
ENABLE_ROUTE_OPTIMIZATION="true"

# Webhooks
WEBHOOK_SECRET="your-webhook-secret-for-external-services"

# Localization
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_SUPPORTED_LOCALES="en,te,hi"

# Demo Mode
ENABLE_DEMO_MODE="false"
DEMO_USER_EMAIL="demo@ivr.local"
DEMO_USER_PASSWORD="Demo123!"

# Development
SKIP_ENV_VALIDATION="false"
ANALYZE="false"
